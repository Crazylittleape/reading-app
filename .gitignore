# Local credentials and machine configuration, at any nesting depth.
.env
.env.*
!.env.example
!.env.*.example
secrets.json
deployment.json
runtime-config.json
runtime-config.js
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*credentials*.json

# Books, uploads, cached content, sessions and rendered builds.
/site/caches/**
!/site/caches/.gitkeep
/site/attachment/**
!/site/attachment/.gitkeep
/site/app/**
!/site/app/.gitkeep
**/node_modules/
**/dist/
**/unpackage/
**/.hbuilderx/
**/__pycache__/
*.pyc
*.epub
*.pdf
*.mobi
*.azw
*.azw3
*.apk
*.ipa
*.wgt
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.sqlite
*.sqlite3
*.db

# Database exports are excluded; only the reviewed schema is versioned.
*.sql
*.sql.*
!/db-init/01-schema.sql
backups/
exports/
logs/
*.log
*.bak
*.dump
*.rdb
*.aof

# Tooling and editor state.
.DS_Store
.idea/
.vscode/
.coverage
htmlcov/
.pytest_cache/
.cache/
tmp/
work/
